# Copy to .env and fill in real values locally. Never commit .env.

VITE_API_BASE_URL=http://localhost:8000

# Map tile source. Defaults to raw OpenStreetMap tiles, which are fine
# for local development but NOT for anything customer-facing -- OSM's
# usage policy prohibits production/commercial use and access can be
# withdrawn without notice (see docs/DECISIONS.md ADR-0007). Swap this
# to a free-tier provider's URL template (Stadia Maps, MapTiler, etc.)
# with your own API key before this goes anywhere near real users.
VITE_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors
