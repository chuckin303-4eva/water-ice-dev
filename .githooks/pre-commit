#!/bin/sh
# Pre-commit gate: tests, lint, type check, security scan.
# Enable with: git config core.hooksPath .githooks
#
# Each section is a placeholder until the corresponding tool is adopted
# (see docs/ARCHITECTURE.md for stack status). Wire in the real command
# and remove the "not configured yet" echo as each tool lands — do not
# leave a step silently passing once a real check exists for it.

set -e

# Load repo-root .env if present so app.core.config.settings can resolve
# DATABASE_URL for test collection (see backend/app/core/config.py).
if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

echo "== pre-commit: tests =="
if [ -f backend/venv/Scripts/python.exe ]; then
  (cd backend && ./venv/Scripts/python.exe -m pytest)
elif [ -f backend/venv/bin/python ]; then
  (cd backend && ./venv/bin/python -m pytest)
else
  echo "  backend/venv not found -- create it per README.md before committing backend changes." >&2
  exit 1
fi

echo "== pre-commit: lint =="
echo "  (not configured yet)"

echo "== pre-commit: type check =="
echo "  (not configured yet)"

echo "== pre-commit: security scan =="
echo "  (not configured yet)"

exit 0
