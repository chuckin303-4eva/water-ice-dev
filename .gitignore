# Secrets / local config — never commit real values
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Dependency directories (per-ecosystem, harmless if unused)
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Build output
dist/
build/
out/
*.log

# Test / coverage output
coverage/
.coverage
.pytest_cache/

# Downloaded exports (locations.csv / competitors.csv, ADR-0013) land at
# repo root in some local dev setups depending on browser download
# defaults -- never intended to be committed.
/*.csv

# Uploaded photos -- local disk storage for now (ADR-0018). User-uploaded
# content, not source; never committed.
backend/uploads/
