# Copy to .env and fill in real values locally. Never commit .env.

# Postgres -- used by infra/docker-compose.yml (POSTGRES_*) and the backend
# app (DATABASE_URL). Keep DATABASE_URL's credentials in sync with the
# POSTGRES_* values below when running against the docker-compose instance.
POSTGRES_USER=water_ice_dev
POSTGRES_PASSWORD=changeme
POSTGRES_DB=water_ice
DATABASE_URL=postgresql+psycopg://water_ice_dev:changeme@localhost:5432/water_ice

# JWT signing (backend/app/core/security.py). Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never reuse this placeholder and never commit a real value.
SECRET_KEY=changeme-generate-your-own-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
